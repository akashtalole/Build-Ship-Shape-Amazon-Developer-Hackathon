{
  "name": "bee-studyloop",
  "version": "0.1.0",
  "description": "StudyLoop: ambient study session coach that turns Bee transcript segments into spaced-repetition flashcards",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
