{
  "name": "friction-log-toolkit",
  "version": "0.1.0",
  "description": "A tiny CLI for capturing friction points in the moment while building, and exporting them as a structured Markdown friction log.",
  "type": "module",
  "bin": {
    "friction-log": "./dist/cli.js"
  },
  "main": "./dist/commands.js",
  "types": "./dist/commands.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && tsx test/smoke.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "cli",
    "friction-log",
    "hackathon",
    "developer-experience",
    "amazon-devices"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.5"
  }
}
